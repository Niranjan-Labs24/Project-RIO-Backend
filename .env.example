NODE_ENV=development
PORT=4000
# If your host's 5432 is already taken (e.g. a native PostgreSQL service), set
# DB_HOST_PORT=<port> here and update the two URLs below to match that port.
# If your host's 3000 is already taken, set API_HOST_PORT=<port> here — this
# only affects `docker compose up api`'s published host port.
# Owner role — used by the Prisma CLI (migrate/seed) AND, at runtime, by
# BackupService's pg_dump connection (APP_DATABASE_URL/SUPERVISOR_DATABASE_URL
# below are both NOBYPASSRLS and would produce an incomplete backup — see
# env.schema.ts's comment on DATABASE_URL).
DATABASE_URL=postgresql://cnap_owner:cnap_owner_dev_pw@localhost:5432/cnap
# Restricted NOBYPASSRLS role — used by the running application
APP_DATABASE_URL=postgresql://cnap_app:cnap_app_dev_pw@localhost:5432/cnap
# Cross-org read-only role (NOBYPASSRLS) — used by the app's runAsSupervisor path
SUPERVISOR_DATABASE_URL=postgresql://cnap_supervisor:cnap_supervisor_dev_pw@localhost:5432/cnap
REDIS_URL=redis://localhost:6379

# --- docker-compose.yml only (not read by the app itself) ---
# These three back the `db`/`api` *containers'* own required env vars — see
# docker-compose.yml's comments. Same dev-only passwords as DATABASE_URL/
# APP_DATABASE_URL/SUPERVISOR_DATABASE_URL above, just addressed to the `db`
# compose service's internal hostname instead of localhost. A real
# deployment supplies its own values for these three via whatever
# secret-injection mechanism it uses — never these defaults.
POSTGRES_PASSWORD=postgres
DOCKER_DATABASE_URL=postgresql://cnap_owner:cnap_owner_dev_pw@db:5432/cnap
DOCKER_APP_DATABASE_URL=postgresql://cnap_app:cnap_app_dev_pw@db:5432/cnap
DOCKER_SUPERVISOR_DATABASE_URL=postgresql://cnap_supervisor:cnap_supervisor_dev_pw@db:5432/cnap
# Express trusted-proxy setting. Keep narrowly scoped to your ingress topology.
TRUST_PROXY=loopback
# JWT signing secret (min 32 chars) — set a strong random value per environment
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=12h
# --- Encryption in transit (RIO-NFR-001) ---
# Set BOTH to serve HTTPS directly; otherwise the app serves HTTP and TLS is
# expected to be terminated by an ingress/reverse proxy in front of it.
# Generate a dev cert:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/dev-key.pem \
#     -out certs/dev-cert.pem -days 365 -subj "/CN=localhost"
# TLS_CERT_PATH=certs/dev-cert.pem
# TLS_KEY_PATH=certs/dev-key.pem
# Connect to Postgres over TLS (RIO-NFR-001). The compose db (db/Dockerfile)
# ships an SSL-enabled server, so this is on by default. Set false only when
# pointing at a Postgres without TLS.
DB_SSL=true
# Verify the Postgres server certificate. Defaults to false so the self-signed
# dev cert works out of the box (encryption without authentication). In
# production set this true — and point DB_SSL_CA at the CA/chain PEM if the
# server cert is not signed by a system-trusted CA — so the DB connection is
# authenticated and not exposed to MITM.
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=certs/db-ca.pem
# pg.Pool `max` for the two runtime connection pools. Defaults (60 / 15) are
# sized for this dev box's Postgres (max_connections=100) — reproduced under
# RIO-NFR-005's 500-concurrent load test that pg's own hardcoded default of
# 10 caused widespread "Unable to start a transaction in the given time"
# failures, since every request opens its own per-request-RLS transaction.
# In production, size against the real Postgres max_connections and account
# for every app instance sharing that same ceiling.
# DB_POOL_MAX_APP=60
# DB_POOL_MAX_SUPERVISOR=15
LOG_LEVEL=info
# Frontend origin allowed to send credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000
# Public-facing base URL for citizen survey links/QR codes. Defaults to
# CORS_ORIGIN if unset; set explicitly when the public app is served from a
# different origin than the one calling this API.
# PUBLIC_APP_URL=http://localhost:3000

# Resend (email API). Leave RESEND_API_KEY unset to disable email; signup
# then reveals the temp password in the response outside production only.
# RESEND_API_KEY=
MAIL_FROM=RIO <no-reply@rio.local>

# Twilio (SMS OTP delivery for the citizen public survey flow). Leave
# TWILIO_ACCOUNT_SID unset to disable SMS; a mobile number then falls back to
# the same dev-only code reveal as the mailer.
#
# Auth — provide ONE of:
#   * API Key (preferred): TWILIO_ACCOUNT_SID + TWILIO_API_KEY_SID (SK...) +
#     TWILIO_API_KEY_SECRET. A key is scoped and revocable on its own.
#   * Auth Token (fallback): TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN.
# TWILIO_ACCOUNT_SID must be the account's 34-char "AC..." SID.
#
# TWILIO_FROM_NUMBER is REQUIRED for SMS in either mode — a number actually
# provisioned on the account, in E.164 format (or a Messaging Service SID).
# NOTE: a verified *email* domain / from-address does not apply to SMS.
# NOTE: a Twilio *trial* account can only SMS pre-verified numbers and adds a
#       trial banner — real citizen OTP needs a paid account.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# TODO (later phase — see MailerService): email currently goes through Resend.
# The client wants it moved to Twilio's Emails API (comms.twilio.com/v1/Emails,
# Basic auth with the same TWILIO_API_KEY_SID/SECRET, from NoReply@impetus.sa).
# That is a separate change to src/mailer/ — a MAIL_PROVIDER toggle + a Twilio
# email transport — not started.
# Bounds every outbound Twilio API call (default 10s; Twilio's own SDK
# default is 30s, too long to leave a citizen's OTP request hanging).
SMS_TIMEOUT_MS=10000

# Opt-in double-submit CSRF (requires the frontend to echo rio_csrf as
# X-CSRF-Token). Keep false until the frontend cooperates / for same-site deploys.
CSRF_ENFORCE=false

# ── Which model provider AiService calls ────────────────────────────────
# oci_cohere (the default) = Cohere Command A on OCI Generative AI, served
# from me-riyadh-1, which keeps inference in-Kingdom.
# gemini = the fallback, for a broken OCI tenancy (expired key, policy
# change, region outage) — one env var instead of a code change.
# Prove a new environment with `npm run ai:oci-smoke` before relying on it.
AI_PROVIDER=oci_cohere

# ── OCI Generative AI (AI_PROVIDER=oci_cohere) ──────────────────────────
# The service API key SECRET itself (starts sk-...), NOT the key's OCID.
# Sent as `Authorization: Bearer <key>`; there is no OCI request signing.
# A key only works in the region it was created in.
# OCI_GENAI_API_KEY=
#
# Required even when using an API key — a request without it is rejected
# with "Compartment ID must be provided." Find it in the OCI Console under
# Identity > Compartments: the compartment your Generative AI IAM policy was
# granted on (ocid1.compartment..., or ocid1.tenancy... for the root).
# OCI_GENAI_COMPARTMENT_ID=
#
# Must match the region the key was issued in. This is what makes the
# in-Kingdom residency claim true, so do not change it casually.
OCI_GENAI_REGION=me-riyadh-1
OCI_GENAI_MODEL_ID=cohere.command-a-03-2025
# ON_DEMAND bills per request. DEDICATED needs a provisioned AI cluster and
# its endpoint OCID as the model id.
OCI_GENAI_SERVING_TYPE=ON_DEMAND
# On-demand inference caps output at 4,000 tokens per run — a ceiling, not
# a target.
OCI_GENAI_MAX_TOKENS=4000
#
# Verify all of the above in one call before switching provider:
#   npm run ai:oci-smoke

# Gemini API key — the fallback provider, used only when
# AI_PROVIDER=gemini. Worth keeping populated even on OCI so switching back
# is genuinely one env var. Optional: unset means that provider has nothing
# to call and should be treated as unavailable, not a startup failure.
# GEMINI_API_KEY=

# Periodic pg_dump backup (BackupService). BACKUP_DIR is created if missing;
# BACKUP_CRON_SCHEDULE is a standard 5-field cron expression. Requires
# pg_dump to be on PATH (see README) and a matching Postgres major version
# to the db server (18) to avoid a client/server version mismatch.
BACKUP_DIR=./storage/backups
# Nightly at 03:00 — what the client-confirmed 24-hour RPO (Q32) requires.
# Use a faster interval (e.g. '*/1 * * * *') to verify a new environment's
# backup works, then put it back to nightly.
BACKUP_CRON_SCHEDULE=0 3 * * *
# Only needed if the bare `pg_dump` on your PATH doesn't match the server's
# major version (common with Homebrew, where multiple Postgres versions can
# be installed but only one is "linked" onto PATH at a time) — point this at
# the correct version's binary explicitly instead. Unset in Docker, where
# only one matching version is ever installed (see Dockerfile).
# PG_DUMP_PATH=/opt/homebrew/opt/postgresql@18/bin/pg_dump
# Same again for pg_restore, which the recoverability check uses to read a
# dump's table of contents (RIO-NFR-010). Version-sensitive in the same way:
# pg_restore refuses an archive written by a newer major version, which would
# report a perfectly good backup as unreadable.
# PG_RESTORE_PATH=/opt/homebrew/opt/postgresql@18/bin/pg_restore


# ─── RIO-AI-004 — semantic duplicate detection ────────────────────────────────
# Uses GEMINI_API_KEY, declared above: meaning-based duplicate matching reuses
# the provider the platform's other AI features already call. EmbeddingProvider
# is the seam if Q10 names a different one.

# The switch that lets need text leave the platform. OFF unless explicitly set.
#
# Q10 (AI provider + in-Kingdom residency) is UNANSWERED, and the client asked
# in writing that the provider integration not be built until it clears. The
# feature is complete and inert: turning it on sends need text — including text
# written by members of the public — to a third-party model. That is a
# deployment decision taken once, with whoever owns data protection in the room,
# which is why it is an environment variable and not a screen toggle.
SEMANTIC_DUPLICATES_ENABLED=false

# ─── RIO-NFR-010 — backups ────────────────────────────────────────────────────
# pg_dump needs a role that can read past row-level security. 47 tables FORCE
# RLS and every application role is NOBYPASSRLS, so a dump run as cnap_owner
# fails outright. Migration 20260904040000 provisions cnap_backup (SELECT only,
# one read policy per RLS table, no write grant anywhere); 20260907000000
# re-covers tables added since.
# ROTATE THIS PASSWORD in any real deployment — it grants read of every tenant's
# data, which is exactly what a dump is. The app says so at every boot while
# this default is still in place (BACKUP_ROLE_DEFAULT_PASSWORD, security/warn):
#   ALTER ROLE cnap_backup WITH PASSWORD '<new>';   -- then update the URL below
BACKUP_DATABASE_URL=postgresql://cnap_backup:cnap_backup_dev_pw@localhost:5432/cnap

# Encryption at rest for backup artefacts (AES-256-GCM). Unset means artefacts
# are stored in clear. Deliberately off rather than on-with-a-generated-key: a
# backup encrypted with a key nobody has escrowed is not a backup. Turning it on
# belongs with deciding who holds the key — that is Q34.
BACKUP_ENCRYPTION_KEY=

# How long a backup file is kept, and when the sweep that deletes expired ones
# runs. The sweep has its own schedule because a period with no backups is
# exactly when disk pressure builds.
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_CRON=30 4 * * *

