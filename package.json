{
  "name": "cnap-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "predev": "npx kill-port 3000",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "extract:methodology": "python scripts/extract-methodology-v5.py",
    "import:methodology": "tsx prisma/import-methodology.ts",
    "import:questions": "tsx prisma/import-questions.ts",
    "import:scoring-lookups": "tsx prisma/import-scoring-lookups.ts",
    "import:domain-priority-config": "tsx prisma/import-domain-priority-config.ts",
    "import:geography": "tsx prisma/import-geography.ts",
    "import:nic-registry": "tsx prisma/import-nic-registry.ts",
    "grant:access": "tsx prisma/grant-access.ts",
    "setup:local": "pnpm run prisma:generate && pnpm run prisma:deploy && pnpm run prisma:seed && pnpm run import:methodology -- --publish && pnpm run import:geography && pnpm run import:nic-registry && pnpm run grant:access",
    "seed:scored": "tsx prisma/seed-scored-study.ts",
    "seed:data-quality": "tsx prisma/seed-data-quality.ts",
    "fix:report-methodology": "tsx prisma/fix-report-methodology-label.ts",
    "score:study": "tsx prisma/score-study.ts",
    "load:seed": "tsx load-test/load-seed.ts",
    "test:load": "artillery run load-test/pilot.yml",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "fast-uri": ">=3.1.5",
      "find-my-way": ">=9.7.0",
      "minimatch@10.2.5>brace-expansion": ">=5.0.9"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "7.9.0",
    "@sinclair/typebox": "^0.33.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "5.6.1",
    "mammoth": "^1.12.0",
    "nestjs-pino": "^4.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "unpdf": "^1.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.9.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "artillery": "^2.0.33",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "prisma": "^7.9.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.0.0"
  }
}
