generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 removed `url` from the schema's datasource block. The CLI
  // (migrate/seed) now reads DATABASE_URL (the cnap_owner role) from
  // prisma.config.ts. The running app overrides the connection at runtime
  // with a driver adapter built from APP_DATABASE_URL (cnap_app) in
  // PrismaService.
  provider = "postgresql"
}

enum UserStatus {
  active
  invited
  disabled
}

enum PermissionModule {
  entityTeam
  rolesPermissions
  onboardingConsent
  methodologyQuestionBank
  studySurvey
  dataCollection
  dataImport
  citizenChannel
  aiReview
  priorityScoring
  reportsDashboards
  archiveSharingAudit
  // Survey Builder (Question Bank + AI-assisted questionnaire design) is its
  // own independent methodology feature, not a Study feature — deliberately
  // not folded into studySurvey. Publish Survey/QR and the Citizen public
  // flow are unrelated and keep using their own existing modules.
  surveyBuilder
  // The NCNP Compiled Report's own review workflow (System Reviewer
  // approve/reject, System Admin generate/publish) — deliberately NOT
  // reusing reportsDashboards (the unrelated RPT01-14 Reports feature):
  // granting reportsDashboards:approve to System Reviewer would also let
  // them approve/reject ordinary org reports through the existing Reports
  // controller, which has no crossEntity guard of its own. `approve` here
  // gates System Reviewer's decision; `write` gates System Admin's
  // generate+publish actions — two distinct bits so neither role can do
  // the other's job even if both hold this module.
  ncnpReport
  // RIO-NFR-016 — the persisted operational log (system_logs). Deliberately
  // NOT folded into archiveSharingAudit: that module is held read-only by
  // ngo_admin, center_supervisor, data_analyst and others, and operational
  // rows carry stack traces, internal paths and integration detail that
  // belong to platform operations, not to tenant governance. Granted to
  // system_admin alone.
  systemLogs
}

// ──────── Reference (global, seeded, read-only to cnap_app) ────────
model Role {
  id          String  @id @db.VarChar(64) // stable seeded id "role_<key>" (matches the FE)
  key         String  @unique @db.VarChar(64)
  name        String  @db.VarChar(120)
  description String
  crossEntity Boolean @map("cross_entity")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  id      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId  String           @map("role_id") @db.VarChar(64)
  module  PermissionModule
  read    Boolean          @default(false)
  write   Boolean          @default(false)
  create  Boolean          @default(false)
  approve Boolean          @default(false)
  export  Boolean          @default(false)
  share   Boolean          @default(false)

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
  @@map("role_permissions")
}

// RIO-DATA-001 — the Requirements Register calls for two separate,
// separately-versioned consents, not one combined policy: the acceptance of
// the platform's use policy, and a distinct data-sharing consent. They are
// separate `kind`s of the same table (rather than two tables) precisely
// because they version, activate and get accepted through identical
// machinery — only the text and the audit meaning differ.
enum ConsentPolicyKind {
  use_policy
  data_sharing
}

model ConsentPolicy {
  id   String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind ConsentPolicyKind @default(use_policy)
  // Versions are per-kind, so `v1` of the use policy and `v1` of the
  // data-sharing consent are two different rows — hence the compound unique
  // below rather than the global `@unique` this column carried when only one
  // policy kind existed.
  version String @db.VarChar(64)
  text    String
  // The same policy, same version, in Arabic — a sibling column rather than a
  // `locale` row (which would have meant widening the unique key to
  // [kind, version, locale] and teaching every "the active policy" lookup to
  // pick a row per language). A translation is not a separate policy: it
  // versions, activates and is superseded in lockstep with `text`, so keeping
  // the pair on one row makes that impossible to get wrong. Mirrors
  // NicRegistry's own nameEn/nameAr precedent.
  //
  // Nullable because a translation can lag its English source: a policy
  // published before its Arabic copy is ready still has to be servable.
  // Readers fall back to `text` (see consentPolicyTextFor) rather than
  // showing an Arabic reader an empty consent.
  textAr    String?  @map("text_ar")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, version])
  // Exactly one row per kind is expected to be active at a time; this index
  // serves the `where: { kind, active: true }` lookup both signup and the
  // public policy endpoint make on every call.
  @@index([kind, active])
  @@map("consent_policies")
}

// ──────── Tenancy & identity ────────
model Organisation {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String   @db.VarChar(200)
  purpose            String?  @db.VarChar(500)
  registrationNumber String?  @unique @map("registration_number") @db.VarChar(100)
  // A org can span more than one region — same array-of-strings shape as
  // `villages` below, not a single free-text field (was `String?` — a
  // comma-separated "Region A, Region B" entry used to be stored as one
  // literal string instead of being treated as multiple regions). This is
  // unrelated free text, not the KSA Geographic Reference link below.
  region             String[] @default([])
  email              String?  @db.VarChar(320)
  // A Domain's `name` from the Methodology Configuration screen (e.g.
  // "Health", "Water & Sanitation") — never a fixed enum, since the whole
  // point is this stays in lockstep with whatever domains are actually
  // configured there. `"other"` is a deliberate escape hatch (paired with
  // `purpose` for the free-text detail), not a methodology domain.
  sector             String?  @db.VarChar(200)
  logoUrl            String?  @map("logo_url")
  villages           String[] @default([])
  // Optional link into the KSA Geographic Reference master data — additive,
  // alongside the existing free-text `region`/`villages` arrays above, not a
  // replacement for them. An org has exactly *one* Region (single-select,
  // hence a plain scalar FK, not a join table), but can span *many*
  // Governorates and *many* Centers — see OrganisationGovernorate/
  // OrganisationCenter below.
  regionId           String?  @map("region_id") @db.Uuid
  isActive           Boolean  @default(true) @map("is_active")
  // RIO-FR-010 (client-confirmed): self-registered entities require Center
  // approval before activation. Separate from `isActive` deliberately —
  // `isActive` alone can't distinguish "never yet approved" (pending, first
  // signup) from "was approved, later suspended" (System Admin deactivated
  // an already-running entity) — those are different situations with
  // different UI/actions. Null = never approved yet. Always non-null for an
  // org created directly by System Admin (OrganizationsService.createWithAdmin),
  // which is inherently pre-approved and skips this gate entirely.
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy         String?   @map("approved_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  regionRef Region? @relation(fields: [regionId], references: [id], onDelete: Restrict)

  orgGovernorates OrganisationGovernorate[]
  orgCenters      OrganisationCenter[]

  users                  User[]
  consents               ConsentAcceptance[]
  auditLogs              AuditLog[]
  studies                Study[]
  needs                  Need[]
  evidence               Evidence[]
  aiDecisions            AiDecision[]
  surveyLinks            PublicSurveyLink[]
  otpChallenges          CitizenOtpChallenge[]
  passwordResetTokens    PasswordResetToken[]
  surveyResponses        SurveyResponse[]
  surveySessions         SurveySession[]
  surveySessionEvents    SurveySessionEvent[]
  responseQualityResults ResponseQualityResult[]
  aiSummaries AiSummary[]
  priorityScores PriorityScore[]
  sharingRequestsOwned SharingRequest[] @relation("SharingRequestsOwned")
  sharingRequestsMade  SharingRequest[] @relation("SharingRequestsMade")
  reportSharingRequestsOwned ReportSharingRequest[] @relation("ReportSharingRequestsOwned")
  reportSharingRequestsMade  ReportSharingRequest[] @relation("ReportSharingRequestsMade")
  reports Report[]
  aiSuggestions AiSuggestion[]
  humanDecisions HumanDecision[]
  surveys Survey[]
  responseAnswers            ResponseAnswer[]
  responseSeverityScores     ResponseSeverityScore[]
  scoreRollups               ScoreRollup[]
  villagePriorityAssessments VillagePriorityAssessment[]
  aiPrioritySummaries        AiPrioritySummary[]
  evidenceDocuments          EvidenceDocument[]
  combinedReportSummaries    CombinedReportSummary[]

  @@index([regionId])
  @@map("organisations")
}

model User {
  id                     String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                  String     @map("org_id") @db.Uuid
  roleId                 String     @map("role_id") @db.VarChar(64)
  name                   String     @db.VarChar(200)
  email                  String     @unique @db.VarChar(320)
  status                 UserStatus @default(invited)
  passwordHash           String?    @map("password_hash") @db.VarChar(255)
  mustChangePassword     Boolean    @default(false) @map("must_change_password")
  consentedAt            DateTime?  @map("consented_at") @db.Timestamptz(6)
  // The policy version accepted at `consentedAt` — kept alongside the
  // timestamp (denormalized from ConsentAcceptance) so a version bump can be
  // detected on every login/me() without an extra join. The full acceptance
  // history still lives in ConsentAcceptance; this is just "what's current."
  consentedPolicyVersion String?    @map("consented_policy_version") @db.VarChar(64)
  // RIO-DATA-001's second consent, denormalized for exactly the same reason
  // as the pair above: the session needs to know whether BOTH consents are
  // current on every login/me() without joining ConsentAcceptance twice. The
  // two pairs move independently — each policy kind versions on its own
  // schedule, so an org can be current on one and stale on the other.
  sharingConsentedAt            DateTime? @map("sharing_consented_at") @db.Timestamptz(6)
  sharingConsentedPolicyVersion String?   @map("sharing_consented_policy_version") @db.VarChar(64)
  failedLoginAttempts    Int        @default(0) @map("failed_login_attempts")
  sessionVersion         Int        @default(0) @map("session_version")
  lockedUntil            DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt            DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  org              Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role             Role                @relation(fields: [roleId], references: [id])
  consents         ConsentAcceptance[]
  passwordResetTokens PasswordResetToken[]
  @@index([orgId])
  @@index([roleId])
  @@map("users")
}

// Forgot-password flow. The raw token is emailed to the user and never
// stored — only its SHA-256 digest (`tokenHash`, a fast deterministic hash
// suitable for exact-match lookup, unlike the salted/slow bcrypt hash used
// for CitizenOtpChallenge's short guessable codes: a 32-byte random token
// has enough entropy that brute-forcing the hash isn't a realistic threat).
model PasswordResetToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  // Set once used to actually reset the password — a consumed token can
  // never be replayed, closing off resubmission via a still-known link.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@map("password_reset_tokens")
}

model ConsentAcceptance {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Which of the two RIO-DATA-001 consents this row records. Every
  // acceptance predating that split was the use policy, so `use_policy` is
  // the backfill default — see the accompanying migration.
  kind          ConsentPolicyKind @default(use_policy)
  orgId         String            @map("org_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  policyVersion String            @map("policy_version") @db.VarChar(64)
  policyText    String            @map("policy_text")
  // Which language's wording `policyText` is — the one actually rendered to
  // this user, not the policy's canonical language. Without it the snapshot
  // is ambiguous the moment a policy exists in more than one language: you
  // could no longer tell an Arabic acceptance from an English one, only that
  // *some* text was agreed to. Defaults to 'en' because every acceptance
  // predating the Arabic copy was necessarily English (see the accompanying
  // migration's backfill).
  policyLocale  String            @default("en") @map("policy_locale") @db.VarChar(8)
  acceptedAt    DateTime          @default(now()) @map("accepted_at") @db.Timestamptz(6)

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  // Drives the per-user, per-kind "has this been accepted, and at which
  // version" lookup the consent gate makes.
  @@index([userId, kind])
  @@map("consent_acceptances")
}

model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.Uuid
  entityLabel    String   @map("entity_label")
  // The submitter's own external tracking id for the entity this event is
  // about (e.g. Need.referenceId — a field form number or partner org's
  // case id) — a first-class, queryable/indexable column rather than
  // buried inside `metadata` JSON, since this is meant to be searched on
  // directly (audit-trail lookups by external reference). Null for events
  // whose entity has no such reference (or never had one set).
  sourceRef      String?  @map("source_ref") @db.VarChar(200)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org Organisation? @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([entityType, entityId])
  @@index([sourceRef])
  @@map("audit_logs")
}

// ──────── RIO-NFR-016: Operational logging ────────

enum SystemLogLevel {
  fatal
  error
  warn
  info
}

// Broad bucket for "which part of the system produced this" — an enum, not
// free text, so the System Logs screen can offer a fixed filter list and a
// typo at a call site can't invent a phantom category.
enum SystemLogCategory {
  http // request/response lifecycle, 4xx/5xx
  database // Prisma/Postgres errors, constraint violations, timeouts
  auth // login failures, token/OTP rejection, permission denials
  integration // outbound: mailer, SMS, AI provider, object storage
  job // scheduled/background work — imports, scoring, report builds
  startup // boot, migration, config validation, shutdown
  security // rate limits, suspicious input, RLS/tenancy violations
  application // catch-all for service-level operational events
}

// RIO-NFR-016 — persisted operational telemetry. Deliberately NOT AuditLog:
// that table is the immutable business-event record (RIO-FR-007) whose own
// acceptance criterion is "cannot be deleted", so it must never carry a
// purge path; this one is diagnostic and time-boxed by a retention window.
// Different volume, different audience, different lifetime.
//
// No `org` relation on purpose: organisationId here is a loose correlation
// key, not ownership. A row about a *failed* org lookup may legitimately
// reference an id that no longer resolves, and deleting an org must never
// cascade away the diagnostic history of what it did.
model SystemLog {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  level          SystemLogLevel
  category       SystemLogCategory
  // Emitting module/service, e.g. "MailerService", "AllExceptionsFilter".
  source         String            @db.VarChar(120)
  // Stable machine code for grouping identical failures over time — e.g.
  // "MAILER_SEND_FAILED", "HTTP_500", "P2002". Indexed: the first question
  // asked on this screen is always "how often is X happening".
  eventCode      String?           @map("event_code") @db.VarChar(80)
  message        String            @db.VarChar(2000)
  // Correlation — mirrors the pino `mixin` fields (see logger.config.ts) so
  // a persisted row and a stdout line for the same request join on
  // request_id.
  requestId      String?           @map("request_id") @db.VarChar(64)
  organisationId String?           @map("organisation_id") @db.Uuid
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  // HTTP shape — null for non-http categories.
  httpMethod     String?           @map("http_method") @db.VarChar(10)
  httpPath       String?           @map("http_path") @db.VarChar(500)
  statusCode     Int?              @map("status_code")
  durationMs     Int?              @map("duration_ms")
  ipAddress      String?           @map("ip_address") @db.VarChar(64)
  userAgent      String?           @map("user_agent")
  // Truncated at write time (SystemLogsService) — a runaway error object
  // must not be able to bloat the table.
  stack          String?
  // Free-form structured detail, redacted and size-capped at write time.
  context        Json?
  // Which API instance emitted the row — matters the moment more than one
  // container is running.
  instanceId     String?           @map("instance_id") @db.VarChar(120)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([eventCode])
  @@index([requestId])
  @@index([organisationId])
  @@map("system_logs")
}

// ──────── Week 2: Data Capture (RIO-FR-001, RIO-FR-Add-01, RIO-FR-003) ────────

// Matches the RIO-FR-001/Add-01/003 flow: draft -> need_captured ->
// evidence_submitted -> ai_classified -> human_reviewed. Uploading evidence
// no longer advances status by itself — a researcher must
// explicitly submit (EvidenceService.submit) before AI Classification is
// allowed to run; that submit action is what sets evidence_submitted.
// A Study is a pure container — no pipeline state of its own. Each Need
// under it runs its own independent lifecycle (see NeedStatus below); a
// Study stays open for new Needs regardless of how far along its existing
// ones are.
model Study {
  id                 String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String      @map("org_id") @db.Uuid
  title              String      @db.VarChar(300)
  // Selected from (or added alongside) the org's own configured villages
  // list — same array-of-strings shape as Organisation.villages, not a
  // master-data table, per the same "don't promote to master data" call
  // made for Need.village. Kept as-is, additive alongside the structured
  // KSA Geographic Reference field below.
  villages  String[]    @default([])
  // Optional link into the KSA Geographic Reference master data — a Study
  // selects a *subset* of the owning Org's own selected Governorates/Centers
  // (see StudyGovernorate/StudyCenter below), validated in
  // StudiesService#assertGeographyInOrgScope both for hierarchy correctness
  // (GeographyService.validateHierarchy) and org-scope membership.
  // Region itself is never stored here — it's derived live from the owning
  // Organisation's own single regionId, never a second copy.
  //
  // Sequential per-org counter (1, 2, 3... across every Study the org has
  // ever created), assigned server-side at creation, never client-writable.
  cycleNumber Int @map("cycle_number")
  // Optional link to the real, status-gated MethodologyVersion master data
  // (the same model Priority Scoring/Question Bank use) — only a PUBLISHED
  // version may be selected (checked in StudiesService, not enforceable by
  // the FK itself). Nullable: can be set later, not required at creation.
  methodologyVersionId String? @map("methodology_version_id") @db.Uuid
  // RIO-FR-024: Sample Size Calculator — signed-off mechanism (Methodology
  // workbook's Sample Size Reference sheet). Entered by the association at
  // creation ("What is the population of your area?"); requiredSampleSize
  // and minimumDetectableEffect are computed and stored at that moment
  // (see StudiesService/sample-size.ts) — never recomputed later, so a
  // report always shows the figures that applied when the study was set up.
  // Nullable: studies created before this feature shipped have none of the
  // four; the coverage confidence criterion below simply doesn't apply to them.
  population Int? @map("population")
  marginOfError Float? @default(0.10) @map("margin_of_error")
  requiredSampleSize Int? @map("required_sample_size")
  minimumDetectableEffect Float? @map("minimum_detectable_effect")
  status String @default("active") @db.VarChar(50)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy String? @map("archived_by") @db.Uuid
  archiveReason String? @map("archive_reason") @db.VarChar(500)
  createdBy String      @map("created_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion? @relation(fields: [methodologyVersionId], references: [id], onDelete: SetNull)
  studyGovernorates StudyGovernorate[]
  studyCenters      StudyCenter[]
  needs    Need[]
  // Denormalized studyId FK kept on these (see each model's own comment) —
  // Study still needs the Prisma back-relation array even though `needId` is
  // now the real scoping key.
  evidence Evidence[]
  aiDecisions AiDecision[]
  surveyLinks PublicSurveyLink[]
  surveyResponses SurveyResponse[]
  surveySessions SurveySession[]
  responseQualityResults ResponseQualityResult[]
  aiSummaries AiSummary[]
  priorityScores PriorityScore[]
  sharingRequests SharingRequest[]
  reports Report[]
  aiSuggestions AiSuggestion[]
  humanDecisions HumanDecision[]
  surveys Survey[]
  responseAnswers            ResponseAnswer[]
  responseSeverityScores     ResponseSeverityScore[]
  scoreRollups               ScoreRollup[]
  villagePriorityAssessments VillagePriorityAssessment[]
  aiPrioritySummaries        AiPrioritySummary[]
  evidenceDocuments          EvidenceDocument[]
  evidenceDocumentSummaries  EvidenceDocumentSummary[]
  combinedReportSummaries    CombinedReportSummary[]

  @@unique([orgId, cycleNumber])
  @@index([orgId])
  @@map("studies")
}

// Each Need under a Study runs its own independent workflow, gated by its
// own `status` — Evidence/AiDecision/Survey/PublicSurveyLink/SurveyResponse
// etc. all key off `needId` now (a Study just groups its Needs; nothing
// about a sibling Need's progress affects another).
enum NeedStatus {
  draft
  // Set immediately on creation (see NeedsService.create) — a Need sits
  // here for the (synchronous, in-process) duration of its automatic AI
  // classification call. Also the state a Need is returned to after an
  // AI Review rejection, so it can be edited and re-classified.
  pending_ai_classification
  evidence_submitted
  ai_classified
  // Classification's fallback chain (AI -> prior Needs in the same
  // geography -> default domain) is designed to always succeed — this
  // value is only reached if every tier fails (e.g. zero active domains
  // configured org-wide). See AiDecisionsService.retryClassification.
  ai_classification_failed
  reviewer_approved
  survey_created
  survey_published
}

// RIO-FR-001: how a Need entered the system — system-assigned only, never a
// free-text field a submitter fills in.
enum NeedSource {
  manual_entry
  file_upload
  citizen_input
  field_survey
}

model Need {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studyId   String     @map("study_id") @db.Uuid
  orgId     String     @map("org_id") @db.Uuid
  title     String     @db.VarChar(300)
  statement String
  // A Need can name more than one village — same array-of-strings shape as
  // Organisation.villages (was `String` — a comma-separated "Village A,
  // Village B" entry used to be stored as one literal string instead of
  // being treated as multiple villages). Do not promote this to a
  // master-data table without an explicit ticket.
  village   String[]   @default([])
  // Optional link into the KSA Geographic Reference master data — multi-
  // select Governorates and Centers (see NeedGovernorate/NeedCenter below):
  // a single Need can span multiple geographic areas. Must be a subset of
  // the owning Study's own selected governorateIds/centerIds — checked in
  // NeedsService, not enforceable by the FK alone.
  // Where this Need came from — assigned by the system based on the actual
  // creation path (see NeedsService.create / NeedsImportService), never
  // client-writable (RIO-FR-001). `citizen_input` and `field_survey` are
  // valid values with no producing code path yet — no feature creates a
  // Need through either route today.
  source    NeedSource
  // The submitter's own external tracking id for this Need (e.g. a field
  // form number or a partner org's case id) — free text, never validated
  // against anything, purely a cross-reference back to their own records.
  referenceId String?  @map("reference_id") @db.VarChar(200)
  // System-generated internal reference, assigned to every Need on
  // creation regardless of entry method (manual or bulk import) — never
  // user-supplied, never edited. Distinct from `referenceId` above, which
  // is the submitter's own external id. Used internally for dedup/merge
  // (RIO-FR-020) and traceability (RIO-NFR-015); not surfaced to citizens.
  // A separate autoincrementing column rather than reusing `id` (a uuidv7)
  // because this needs to stay stable and human-legible in reports/dedup
  // UI — format as "NEED-<internalRefSeq zero-padded to 6 digits>" at the
  // application layer, not stored as a string, so there's one source of
  // truth for the number.
  internalRefSeq Int @default(autoincrement()) @map("internal_ref_seq")
  // Roughly how many people this Need affects, as estimated by whoever
  // recorded it (client-confirmed Option A, 24 Aug 2026 — the answer to the
  // need-entry question "Roughly how many people does this need affect?").
  // This is the ONLY per-need population figure in the system and the sole
  // source for the Top-Priority Report's Affected Population column.
  // Deliberately NOT derived from Study.population: that figure covers the
  // whole study area and sizes the sample, so writing it here would claim
  // every need affects everyone. Nullable and stays null forever for Needs
  // recorded before this field existed — the estimate cannot be
  // reconstructed after the fact, because nobody was asked at the time.
  affectedPopulation Int? @map("affected_population")
  status    NeedStatus @default(draft)
  // The AUTHORITATIVE ("Approved") Domain + Sub-Domain for this Need —
  // ALWAYS mirrors the first row of `needDomains` below (the real,
  // multi-valued source of truth) so any reader not yet migrated to the
  // full list — e.g. a table column, a one-line subtitle — still shows at
  // least the primary domain rather than nothing. Never write this pair
  // directly without also writing/replacing the matching `needDomains`
  // rows; see AiDecisionsService for the one place both are kept in sync.
  // Distinct from aiSuggestedDomain/aiSuggestedSubDomain below, which is
  // never overwritten once classification runs — domain/subDomain (and
  // needDomains) are the human's final decision, which may differ from
  // the AI's suggestion.
  domain    String?    @db.VarChar(120)
  subDomain String?    @map("sub_domain") @db.VarChar(120)
  // True when AI could not confidently classify this Need at all (an
  // "unclear need" outcome, not a hard failure — see
  // AiDecisionsService.runAndPersistClassification) and every active
  // Domain/Sub-domain is implicitly in scope rather than one specific
  // pair. `needDomains` stays empty in this case — deliberately not
  // materialized as ~40 literal rows — so Question Bank matching checks
  // this flag first and skips filtering entirely rather than iterating a
  // real list. Cleared the moment a human (Researcher or Approver)
  // narrows it down via Override, which populates needDomains for real.
  allDomainsSelected Boolean @default(false) @map("all_domains_selected")
  // AI Classification's own suggestion — stored for transparency/future
  // reference only, never read by anything downstream (Survey Builder's
  // Question Bank matching, reporting, scoring all use `domain`/`subDomain`
  // above instead). Written once a human approves or overrides an AI
  // Classification decision (see AiDecisionsService.review) — the human's
  // own review of the AI's suggestion still happens exactly as before, it
  // just no longer writes onto the authoritative field.
  aiSuggestedDomain    String? @map("ai_suggested_domain") @db.VarChar(120)
  aiSuggestedSubDomain String? @map("ai_suggested_sub_domain") @db.VarChar(120)
  // When the most recent classification attempt completed (success or
  // failure) — cleared back to null and re-set on every retry, so it
  // always reflects the latest attempt only, never a stale earlier one.
  classifiedAt DateTime? @map("classified_at") @db.Timestamptz(6)
  // Populated only when status = ai_classification_failed; cleared on
  // retry before the next attempt runs. Never shown to citizens, only to
  // Researchers/Approvers on the Need workspace / AI Review screens.
  classificationError String? @map("classification_error")
  // A staged (not-yet-decided) Override — set when a Researcher or Approver
  // clicks "Preview Override" (see AiDecisionsService.overrideDomainPreview),
  // cleared the moment it's consumed (approved-into-domain/needDomains, or
  // discarded on Reject). Deliberately NOT the authoritative classification
  // — domain/subDomain/needDomains above are the only fields anything
  // downstream (Question Bank matching, scoring, reporting) ever reads;
  // this exists purely so a proposal survives the round trip from whoever
  // staged it (any session, any device) to whoever reviews/approves it,
  // replacing an earlier sessionStorage-only draft that only the browser
  // tab that staged it could ever see. Array of {domain, subDomain} pairs,
  // same shape as needDomains, since an override can span several.
  proposedDomains Json?   @map("proposed_domains")
  proposedReason  String? @map("proposed_reason")
  createdBy String     @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  study Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  needGovernorates NeedGovernorate[]
  needCenters NeedCenter[]
  needDomains NeedDomain[]
  evidence Evidence[]
  aiDecisions AiDecision[]
  surveys Survey[]
  surveyLinks PublicSurveyLink[]
  surveyResponses SurveyResponse[]
  surveySessions SurveySession[]
  responseQualityResults ResponseQualityResult[]
  aiSummaries AiSummary[]
  priorityScores PriorityScore[]
  aiSuggestions AiSuggestion[]
  evidenceDocuments EvidenceDocument[]

  @@index([orgId])
  @@index([studyId])
  @@map("needs")
}

// Multi-select Domain/Sub-domain pairs for a Need — a Need can be manually
// classified into more than one Domain, each with one or more Sub-domains
// (e.g. Health/Access to Basic Healthcare AND Water & Sanitation/Drinking
// Water Access on the same Need). Plain name strings, not a relation to
// Domain/SubDomain — same "stores the name, not the id" convention as
// Need.domain/subDomain and AiDecision.suggestion. org_id is denormalized
// directly from Need.orgId (not joined through Need), same self-contained
// RLS pattern as NeedGovernorate/NeedCenter below. Empty (zero rows) while
// Need.allDomainsSelected is true — see that field's comment; a real,
// specific selection always replaces the full set at once (see
// AiDecisionsService), never an incremental add/remove of individual rows.
model NeedDomain {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  needId    String   @map("need_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  domain    String   @db.VarChar(120)
  subDomain String   @map("sub_domain") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@unique([needId, domain, subDomain])
  @@index([orgId])
  @@map("need_domains")
}

// Multi-select Governorates for a Need — a Need selects a *subset* of the
// owning Study's own selected Governorates (checked in NeedsService, not
// enforceable by the FK alone). org_id is denormalized directly from
// Need.orgId (not joined through Need) so this table gets a clean,
// self-contained org-isolation RLS policy, the same pattern every other
// org-scoped table in this schema uses.
model NeedGovernorate {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  needId        String   @map("need_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  governorateId String   @map("governorate_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  need        Need        @relation(fields: [needId], references: [id], onDelete: Cascade)
  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)

  @@unique([needId, governorateId])
  @@index([governorateId])
  @@index([orgId])
  @@map("need_governorates")
}

// Multi-select Centers for a Need — org_id is denormalized directly from
// Need.orgId (not joined through Need) so this table gets a clean,
// self-contained org-isolation RLS policy, the same pattern every other
// org-scoped table in this schema uses.
model NeedCenter {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  needId    String   @map("need_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  need   Need   @relation(fields: [needId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([needId, centerId])
  @@index([centerId])
  @@index([orgId])
  @@map("need_centers")
}

// A Study selects a *subset* of the owning Org's own selected Governorates —
// same org-scoped join-table pattern as OrganisationGovernorate/NeedCenter
// (org_id denormalized for a clean, self-contained RLS isolation policy).
model StudyGovernorate {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studyId       String   @map("study_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  governorateId String   @map("governorate_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  study       Study       @relation(fields: [studyId], references: [id], onDelete: Cascade)
  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)

  @@unique([studyId, governorateId])
  @@index([governorateId])
  @@index([orgId])
  @@map("study_governorates")
}

// Same pattern as StudyGovernorate above, for a Study's selected Centers
// (must belong to one of the Study's own selected Governorates — checked in
// StudiesService, not enforceable by the FK itself).
model StudyCenter {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studyId   String   @map("study_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  study  Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([studyId, centerId])
  @@index([centerId])
  @@index([orgId])
  @@map("study_centers")
}

// RIO-FR-Add-01: multiple files per Study, uploaded after the Need exists.
// storageKey is a local disk path for Phase 1 — kept as a plain string so
// swapping to an object-storage key later needs no schema change.
model Evidence {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  needId             String    @map("need_id") @db.Uuid
  studyId            String    @map("study_id") @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  fileName           String    @map("file_name") @db.VarChar(255)
  fileType           String    @map("file_type") @db.VarChar(100)
  fileSize           Int       @default(0) @map("file_size")
  storageKey         String    @map("storage_key") @db.VarChar(500)
  fileHash           String?   @map("file_hash") @db.VarChar(64)
  title              String?   @map("title") @db.VarChar(300)
  sourceReferenceId  String?   @map("source_reference_id") @db.VarChar(200)
  linkedDomainOrKpi  String?   @map("linked_domain_or_kpi") @db.VarChar(200)
  description        String?   @map("description")
  collectedAt        DateTime? @map("collected_at") @db.Timestamptz(6)
  reviewStatus       String    @default("APPROVED") @map("review_status") @db.VarChar(50)
  isIncludedInReport Boolean   @default(true) @map("is_included_in_report")
  uploadedBy         String    @map("uploaded_by") @db.Uuid
  uploadedAt         DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  need  Need         @relation(fields: [needId], references: [id], onDelete: Cascade)
  study Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([needId])
  @@index([studyId])
  @@index([orgId])
  @@index([needId, fileHash])
  @@map("evidence")
}

// RIO-FR-003: only the two touchpoints Week 2 produces a placeholder for.
// More values (evidence_summary, report_summary, etc.) get added later by
// whichever team builds those stages.
enum AiTouchpoint {
  need_classification
  priority_scoring
}

// One generic table for every AI touchpoint — AI suggestion and human
// override are separate columns on the same row (auditable, explainable),
// not a separate table per touchpoint.
//
// TODO(RIO-FR-003): `suggestion`'s shape and how `confidence` is computed
// are both placeholders pending the buyer-provided methodology package —
// see ai-decisions/classification.placeholder.ts.
model AiDecision {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  needId        String       @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId       String       @map("study_id") @db.Uuid
  touchpoint    AiTouchpoint
  subjectType   String       @map("subject_type") @db.VarChar(100)
  subjectId     String       @map("subject_id") @db.Uuid
  modelName     String       @map("model_name") @db.VarChar(150)
  modelVersion  String       @map("model_version") @db.VarChar(100)
  suggestion    Json
  confidence    Decimal
  humanDecision Json?        @map("human_decision")
  decidedBy     String?      @map("decided_by") @db.Uuid
  decidedAt     DateTime?    @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need  Need         @relation(fields: [needId], references: [id], onDelete: Cascade)
  study Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([needId])
  @@index([subjectType, subjectId])
  @@map("ai_decisions")
}

// ──────── Domain / Sub-Domain Master Module ────────
// Global reference/master data (no orgId, no RLS — same pattern as Role/
// ConsentPolicy) seeded from question-bank-v1.json's Domain/Sub-Domain
// hierarchy ONLY (not its Indicators/KPIs/Questions, which belong to the
// separately-owned Question Bank module). Consumed by the AI Override
// screen's domain/sub-domain dropdowns; never used during Need creation.
// Deactivate rather than delete — a retired domain/sub-domain must not
// vanish from historical AiDecision rows that already reference it by name.
model Domain {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subDomains SubDomain[]

  @@map("domains")
}

model SubDomain {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  domainId     String   @map("domain_id") @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@map("sub_domains")
}

// ──────── KSA Geographic Reference (global, seeded, read-only to cnap_app) ────────
// Official Saudi Arabia administrative hierarchy — Region -> Governorate ->
// Center, per the Regions System (Royal Order A/92, 1412H/1992): 13 regions,
// 150 governorates (including the amanahs of region capitals), 1,404
// centers. Same pattern as Domain/SubDomain/Question — no org_id, no RLS,
// seeded via prisma/import-geography.ts (idempotent upsert on `code`), pure
// reference data for Organisation.regionId/governorateId/centerId to point
// at. No deactivate/soft-delete flag: unlike Domain/SubDomain (which a
// Methodology admin curates over time), this hierarchy is a fixed external
// standard, not something the app edits.
model Region {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The spreadsheet's own numeric region code (1-13), not a UUID — this is
  // what the source data and any future re-import key off of.
  code    Int    @unique
  name    String @db.VarChar(150)
  // ISO 3166-2 subdivision code, e.g. "SA-01".
  isoCode String @unique @map("iso_code") @db.VarChar(10)
  capital String @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  governorates Governorate[]
  orgs         Organisation[]

  @@map("regions")
}

model Governorate {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The spreadsheet's own "Gov Code", e.g. "0101" — a zero-padded string,
  // not numeric (some codes carry meaningful leading zeros).
  code     String @unique @db.VarChar(10)
  regionId String @map("region_id") @db.Uuid
  name     String @db.VarChar(150)
  // "Amanah (Region capital)" | "Category A" | "Category B" — free text
  // exactly as the source spreadsheet labels it, not a fixed enum, since
  // the source is the sole authority on what categories exist.
  category String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  region          Region                    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  centers         Center[]
  orgGovernorates OrganisationGovernorate[]
  studyGovernorates StudyGovernorate[]
  needGovernorates NeedGovernorate[]

  @@index([regionId])
  @@map("governorates")
}

model Center {
  id            String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The spreadsheet's own "Center Code", e.g. "0101-001".
  code          String @unique @db.VarChar(20)
  governorateId String @map("governorate_id") @db.Uuid
  name          String @db.VarChar(150)
  // "Category A" | "Category B".
  category      String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  governorate Governorate          @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  orgCenters  OrganisationCenter[]
  needCenters NeedCenter[]
  studyCenters StudyCenter[]

  @@index([governorateId])
  @@map("centers")
}

// ──────── NIC entity registry (global, seeded, read-only to cnap_app) ────────
// The published register of entities and supervisory units (الكيانات والوحدات
// الاشرافية). Same pattern as the geographic reference above — no org_id, no
// RLS, seeded via prisma/import-nic-registry.ts (idempotent upsert on
// `nic_number`) from Entities_Supervisory_Units.xlsx.
//
// Sole purpose today: gate self-service signup. AuthService.signup rejects a
// registration number that isn't a NIC number in here, so an org row can only
// ever be created for an entity the registry knows about (see
// NicRegistryService.assertRegistered).
//
// The descriptive columns are all nullable on purpose: matching only ever
// keys off `nic_number`, and a future export that drops or renames a
// descriptive column must not be able to fail the import that keeps the gate
// current.
model NicRegistry {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The entity's unified national number — 10 digits in every row of the
  // source workbook (all 7,840 distinct), stored normalized (ASCII digits,
  // no separators) so the comparison in assertRegistered is a plain equality
  // check against an indexed column.
  nicNumber String @unique @map("nic_number") @db.VarChar(10)

  nameEn                String?   @map("name_en") @db.VarChar(500)
  nameAr                String?   @map("name_ar") @db.VarChar(500)
  // The workbook's own License_Number — free-text, non-unique, and NOT what
  // signup matches on. Kept for support: it's the number an entity is most
  // likely to quote when they dispute a rejection.
  licenseNumber         String?   @map("license_number") @db.VarChar(50)
  supervisoryAgencyName String?   @map("supervisory_agency_name") @db.VarChar(500)
  licenseExpiryDate     DateTime? @map("license_expiry_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("nic_registry")
}

// An org has exactly one Region (plain scalar FK on Organisation itself, see
// Organisation.regionId), but can independently span many Governorates and
// many Centers (not necessarily one Center per selected Governorate) — each
// gets its own join table rather than one nested/polymorphic structure, same
// convention throughout this schema (see the deliberate choice not to
// generalize this pattern with Report Sharing's own join table, documented
// on ReportSharingRequest below). Org-scoped (has org_id, RLS applies —
// unlike Region/Governorate/Center themselves, which are global reference
// data with no org_id).
model OrganisationGovernorate {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  governorateId String   @map("governorate_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  governorate Governorate  @relation(fields: [governorateId], references: [id], onDelete: Restrict)

  @@unique([orgId, governorateId])
  @@index([governorateId])
  @@map("organisation_governorates")
}

model OrganisationCenter {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  center Center       @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([orgId, centerId])
  @@index([centerId])
  @@map("organisation_centers")
}

// ──────── Publish Survey + Generate QR / Citizen public flow ────────
// Tenant-scoped (org_id + RLS, same isolation pattern as Study/Need/
// Evidence) even though the citizen-facing routes that read/write
// CitizenOtpChallenge/SurveyResponse rows are unauthenticated — those
// routes resolve the owning org from the PublicSurveyLink token first
// (cross-org SELECT via the cnap_supervisor connection, same technique
// TenantPrismaService.runAsSupervisor already uses), then write through
// TenantPrismaService.runAsOrg(resolvedOrgId, ...), which is exactly how
// the org-creation bootstrap path (no signed-in actor yet either) already
// writes under RLS.
model PublicSurveyLink {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  needId    String    @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId   String    @map("study_id") @db.Uuid
  // User-facing name ("Baseline Survey", "Village A Outreach") — the only
  // identifier shown anywhere in the UI; unique per Need (not globally, and
  // not per-Study either — two Needs under the same Study each run an
  // independent survey and may each have their own "Baseline Survey" link).
  // Required, trimmed, max 150 chars — enforced at the service layer since
  // Postgres has no built-in trim-then-check-blank constraint.
  label     String    @db.VarChar(150)
  // Opaque public-URL token (/public/survey/:token) — never the raw study
  // id, so a citizen link can be revoked/rotated independently of the Study.
  token     String    @unique @db.VarChar(64)
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org                    Organisation            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need                   Need                    @relation(fields: [needId], references: [id], onDelete: Cascade)
  study                  Study                   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  otpChallenges          CitizenOtpChallenge[]
  responses              SurveyResponse[]
  sessions               SurveySession[]
  responseQualityResults ResponseQualityResult[]
  aiSummaries            AiSummary[]
  priorityScores         PriorityScore[]

  @@unique([needId, label])
  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@map("public_survey_links")
}

// Provider-agnostic OTP delivery (current implementation may send via
// email; swapping to SMS later must not require a contract change) — see
// RIO-FR-Add-02. `codeHash` only, never the plaintext code at rest.
model CitizenOtpChallenge {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  surveyLinkId String    @map("survey_link_id") @db.Uuid
  // Email — kept as `contact` (not renamed) since every downstream reader
  // (reports, scoring, respondent dedup — see SurveyResponse.contact's own
  // comment) already treats this column as the respondent's email identity.
  contact      String    @db.VarChar(320)
  // Mobile number — new, alongside `contact`. Both are required by the
  // request contract (RequestOtpBody) for every new challenge going
  // forward; nullable here only so existing pre-this-feature rows don't
  // need a backfill. The same OTP code is sent to both (see
  // CitizenService.requestOtp) and verifies regardless of which one the
  // respondent actually checked.
  mobile       String?   @db.VarChar(32)
  codeHash     String    @map("code_hash") @db.VarChar(255)
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  // Set once this challenge has been used to successfully submit a
  // SurveyResponse — a verified-but-already-consumed challenge can no
  // longer submit again, closing off resubmission via a still-known
  // challengeId (see CitizenService.submitResponse()).
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  surveyLink PublicSurveyLink @relation(fields: [surveyLinkId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([surveyLinkId])
  @@map("citizen_otp_challenges")
}

// Self-reported by the citizen respondent — a fixed, small vocabulary
// (not a free-text field) so gender-wise reporting can group on it directly.
enum Gender {
  male
  female
  other
  prefer_not_to_say
}

// Self-reported rural/urban settlement — a fixed vocabulary (like Gender) so
// rural/urban reporting can group on it directly. Nullable: not every response
// captures it, and the demographic charts omit the series when it's absent.
enum SettlementType {
  rural
  urban
}

// Self-reported age bracket — a fixed vocabulary (like Gender), never exact
// age or date of birth, so age-wise reporting can group on it directly
// without ever storing individually-identifying birth data. Mandatory on
// new submissions (see citizen.contract.ts's SubmitResponseBody), but
// nullable here: responses collected before this field existed have no
// value, and that absence must never be treated as zero or backfilled — see
// NcnpReportService's age-bracket aggregation for the historical-data note.
enum AgeBracket {
  age_15_24   @map("15-24")
  age_25_34   @map("25-34")
  age_35_44   @map("35-44")
  age_45_54   @map("45-54")
  age_55_64   @map("55-64")
  age_65_plus @map("65+")
  prefer_not_to_say
}

// Generic response row — Response Quality, AI Summary, and Priority
// Dashboard all read from this same table, seeded or real alike.
model SurveyResponse {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  needId       String   @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId      String   @map("study_id") @db.Uuid
  surveyLinkId String   @map("survey_link_id") @db.Uuid
  contactName  String?  @map("contact_name") @db.VarChar(200)
  // Email — see CitizenOtpChallenge.contact's comment; every downstream
  // reader (reports, scoring, respondent dedup) already treats this as the
  // respondent's email identity, so it keeps its existing name.
  contact      String   @db.VarChar(320)
  // Mobile number — new, alongside `contact`. Both are copied from the
  // CitizenOtpChallenge that verified this submission (see
  // CitizenService.submitResponse); either one matching a prior response
  // for this Need counts as a duplicate (see the two unique constraints
  // below), since either channel uniquely identifies a person. Nullable
  // only so pre-this-feature rows don't need a backfill — Postgres treats
  // multiple NULLs as distinct under a unique index, so this doesn't weaken
  // the dedup guarantee for any row that does have one.
  mobile       String?  @db.VarChar(32)
  gender       Gender?
  settlementType SettlementType? @map("settlement_type")
  ageBracket     AgeBracket?     @map("age_bracket")
  // Geography snapshot — copied from the Need (its own multi-select
  // Governorates/Centers, village) and the Organization (regionId) at
  // submission time, not asked of the citizen directly. A pure denormalized
  // copy for future governorate/village-wise reporting (see
  // Need.needGovernorates/NeedCenter/Need.village and
  // Organisation.regionId) — never independently edited, so plain array
  // columns rather than a join table are enough here.
  regionId       String?  @map("region_id") @db.Uuid
  governorateIds String[] @default([]) @map("governorate_ids") @db.Uuid
  centerIds      String[] @default([]) @map("center_ids") @db.Uuid
  village        String[] @default([])
  answers      Json
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  org        Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  study      Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  need       Need             @relation(fields: [needId], references: [id], onDelete: Cascade)
  surveyLink PublicSurveyLink @relation(fields: [surveyLinkId], references: [id], onDelete: Cascade)
  qualityResults ResponseQualityResult[]
  session        SurveySession?
  responseAnswers        ResponseAnswer[]
  responseSeverityScores ResponseSeverityScore[]

  // Scoped to needId, not studyId — each Need runs its own independent
  // survey, so the same contact may legitimately respond once per Need
  // under the same Study (see CitizenService.checkDuplicate/submitResponse).
  // Two separate constraints (not one composite) so a match on EITHER
  // channel alone is enough to block a second submission.
  @@unique([needId, contact])
  @@unique([needId, mobile])
  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@index([surveyLinkId])
  @@map("survey_responses")
}

// ──────── Response Quality + AI Summary ────────
// Same placeholder pattern as ai-decisions: a pure function computes canned
// output, a real service reads real SurveyResponse rows and writes a real
// result row here. "Response Quality" measures the responses themselves
// (completeness, confidence, duplicates) — not survey design.
enum ConfidenceFlag {
  standard
  low
}

model ResponseQualityResult {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String         @map("org_id") @db.Uuid
  needId            String         @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId           String         @map("study_id") @db.Uuid
  // Null = computed from every Survey Link's responses *for this Need*
  // ("Consolidated" scope, scoped within the Need — a sibling Need's links
  // never mix in); set = computed from just that one link's responses. Lets
  // the Insights "Survey Scope" selector read back exactly the scope it
  // wrote, instead of always mixing every link's results together.
  surveyLinkId      String?        @map("survey_link_id") @db.Uuid
  surveyResponseId  String         @map("survey_response_id") @db.Uuid
  completenessScore Int            @map("completeness_score")
  missingFields     String[]       @map("missing_fields")
  confidenceFlag    ConfidenceFlag @map("confidence_flag")
  isDuplicate       Boolean        @default(false) @map("is_duplicate")
  duplicateOfId     String?        @map("duplicate_of_id") @db.Uuid
  assessedAt        DateTime       @default(now()) @map("assessed_at") @db.Timestamptz(6)

  org            Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need           Need              @relation(fields: [needId], references: [id], onDelete: Cascade)
  study          Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  surveyLink     PublicSurveyLink? @relation(fields: [surveyLinkId], references: [id], onDelete: Cascade)
  surveyResponse SurveyResponse    @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@index([surveyLinkId])
  @@map("response_quality_results")
}

// One row per generation (history retained); GET reads the latest per scope.
model AiSummary {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  needId        String   @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId       String   @map("study_id") @db.Uuid
  // Same null = Consolidated (within this Need) / set = single-link
  // convention as ResponseQualityResult.surveyLinkId above.
  surveyLinkId  String?  @map("survey_link_id") @db.Uuid
  summaryText   String   @map("summary_text")
  responseCount Int      @map("response_count")
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  org        Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need       Need              @relation(fields: [needId], references: [id], onDelete: Cascade)
  study      Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  surveyLink PublicSurveyLink? @relation(fields: [surveyLinkId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@index([surveyLinkId])
  @@map("ai_summaries")
}

// ──────── Priority Dashboard + Explainable Score ────────
// TODO(RIO-Priority): placeholder scoring only — see
// priority/priority.placeholder.ts. Real methodology scoring workbook
// replaces just that function later; this table/API shape doesn't change.
enum PriorityLevel {
  critical
  high
  medium
  low
}

model PriorityScore {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  needId       String        @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId      String        @map("study_id") @db.Uuid
  // Same null = Consolidated (within this Need) / set = single-link
  // convention as ResponseQualityResult.surveyLinkId above.
  surveyLinkId String?       @map("survey_link_id") @db.Uuid
  overallScore Int           @map("overall_score")
  level        PriorityLevel
  gapType      String        @map("gap_type") @db.VarChar(50)
  // Explainable breakdown: one entry per Question Bank indicator that fed
  // this score — { indicator, weight, responseValue, weightedContribution }
  // — plus the equity-flag/normalization inputs. See priority/scoring.ts.
  factors      Json
  cycleNote    String?       @map("cycle_note") @db.VarChar(200)
  scoredAt     DateTime      @default(now()) @map("scored_at") @db.Timestamptz(6)
  // Priority Scoring stays subject to reviewer approval, same as AI
  // Classification — never publicly visible (e.g. Priority Dashboard) until
  // approved. Nullable/false until a reviewer acts (see PriorityService.approve).
  approvedBy   String?       @map("approved_by") @db.Uuid
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz(6)

  org        Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need       Need              @relation(fields: [needId], references: [id], onDelete: Cascade)
  study      Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  surveyLink PublicSurveyLink? @relation(fields: [surveyLinkId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@index([surveyLinkId])
  @@map("priority_scores")
}

// ──────── Sharing Requests, Approval, Shared Reports ────────
// Deliberately NOT org-scoped RLS like every other tenant table: a sharing
// request is inherently visible to TWO orgs (the owner being asked, and the
// requester asking) plus the cross-entity Center Supervisor — a single
// `org_id = current_org_id` policy can't express "visible to either side."
// Authorization here is enforced at the service layer instead (ownerOrgId
// must equal caller's org to approve/reject; requestingOrgId must equal
// caller's org to create), same spirit as Domain/SubDomain's no-RLS
// reference-table pattern, just app-enforced instead of RLS-enforced.
enum SharingStatus {
  pending
  approved
  rejected
  expired
}

model SharingRequest {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerOrgId       String        @map("owner_org_id") @db.Uuid
  requestingOrgId  String        @map("requesting_org_id") @db.Uuid
  studyId          String        @map("study_id") @db.Uuid
  status           SharingStatus @default(pending)
  requestedBy      String        @map("requested_by") @db.Uuid
  requestedAt      DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy        String?       @map("decided_by") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(6)
  note             String?       @db.VarChar(1000)
  // Optional reason the owner org gives when rejecting (or, less commonly,
  // approving with a caveat) — same field shape as ReportSharingRequest.
  decisionNote     String?       @map("decision_note") @db.VarChar(1000)

  ownerOrg      Organisation @relation("SharingRequestsOwned", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  requestingOrg Organisation @relation("SharingRequestsMade", fields: [requestingOrgId], references: [id], onDelete: Cascade)
  study         Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([ownerOrgId])
  @@index([requestingOrgId])
  @@index([studyId])
  @@map("sharing_requests")
}

// Report Sharing (RIO-FR-014) — structurally identical to SharingRequest
// above but keyed on Report instead of Study. Kept as its own table rather
// than generalizing SharingRequest into one polymorphic
// entity-type/entity-id row: this schema already has direct precedent for
// one-join-table-per-relationship even between conceptually near-identical
// links (see OrganisationGovernorate vs OrganisationCenter above, not one
// generic "OrganisationGeographyLink"), and a real Prisma FK (with its
// cascade rule) can only ever point at one table, so a polymorphic id would
// trade away referential integrity for a generalization this codebase
// doesn't use anywhere else. The actual code (service logic, frontend UI)
// still avoids duplication — see ReportSharingService/SharingService's
// shared base type and the shared `<SharingRequestsPage>` frontend
// component, not this schema.
model ReportSharingRequest {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerOrgId       String        @map("owner_org_id") @db.Uuid
  requestingOrgId  String        @map("requesting_org_id") @db.Uuid
  reportId         String        @map("report_id") @db.Uuid
  status           SharingStatus @default(pending)
  requestedBy      String        @map("requested_by") @db.Uuid
  requestedAt      DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy        String?       @map("decided_by") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(6)
  note             String?       @db.VarChar(1000)
  decisionNote     String?       @map("decision_note") @db.VarChar(1000)

  ownerOrg      Organisation @relation("ReportSharingRequestsOwned", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  requestingOrg Organisation @relation("ReportSharingRequestsMade", fields: [requestingOrgId], references: [id], onDelete: Cascade)
  report        Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([ownerOrgId])
  @@index([requestingOrgId])
  @@index([reportId])
  @@map("report_sharing_requests")
}

// ──────── Reports Module (RPT-01..RPT-13) ────────
// One flexible report engine, not 13 bespoke tables — `reportType` is a
// discriminator, `filters`/`content` carry the type-specific shape.
// RPT-12 (Report Sharing Status) is a read view over SharingRequest, not
// separate data — its `content` is populated from that table at generation
// time, not stored redundantly elsewhere.
enum ReportType {
  RPT01
  RPT02
  RPT03
  RPT04
  RPT05
  RPT06
  RPT07
  RPT08
  RPT09
  RPT10
  RPT11
  RPT12
  RPT13
  RPT14
  RPT15
  RPT16
  RPT17
}

enum ReportStatus {
  draft
  // Client-confirmed (Aug 13): a distinct state for "the Officer confirmed
  // it, awaiting the Reviewer's decision" — previously confirm() stamped
  // officerConfirmedAt but left status at "draft", which read as
  // unconfirmed and confused the Officer into thinking confirm had failed.
  // Reached only via ReportsService.confirm(); approve()/reject() require
  // it (not "draft") to move a report onward.
  submitted
  rejected
  released
  archived
}

model Report {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  reportType  ReportType   @map("report_type")
  status      ReportStatus @default(draft)
  title       String       @db.VarChar(300)
  // Only set for study-scoped types (e.g. RPT-04 Domain-wise Needs);
  // null for org-wide aggregate types (e.g. RPT-02 Collective Dashboard).
  studyId      String?      @map("study_id") @db.Uuid
  // Only set for survey-scoped types — RPT-01 (Individual Survey Report) and
  // RPT-15 (Combined Survey + Dashboard Report) are generated from ONE survey,
  // so without this two surveys under the same study produce two reports that
  // can't be told apart. Null for study-scoped and org-wide types.
  // onDelete: SetNull — a released report is an archival record and outlives
  // the survey it was generated from.
  surveyId     String?      @map("survey_id") @db.Uuid
  filters      Json
  content      Json
  generatedBy  String       @map("generated_by") @db.Uuid
  generatedAt  DateTime     @default(now()) @map("generated_at") @db.Timestamptz(6)
  // Two-step approval: Officer confirms a draft first, then a Reviewer
  // approves (see ReportsService.confirm/approve) — reviewedBy/At is the
  // second (Reviewer) step, officerConfirmedBy/At is the first.
  officerConfirmedBy String?   @map("officer_confirmed_by") @db.Uuid
  officerConfirmedAt DateTime? @map("officer_confirmed_at") @db.Timestamptz(6)
  reviewedBy   String?      @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  // Mandatory on both approve and reject (RIO-FR-007 clarification: the
  // notes requirement extends to all four report categories, not just the
  // NCNP Compiled Report) — see ReportsService.approve/reject.
  reviewerNotes String?     @map("reviewer_notes")
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(6)

  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  study  Study?       @relation(fields: [studyId], references: [id], onDelete: Cascade)
  survey Survey?      @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  sharingRequests ReportSharingRequest[]

  @@index([orgId])
  @@index([reportType])
  @@index([surveyId])
  @@map("reports")
}

// The NCNP Compiled Report's own approval workflow — deliberately NOT a
// `Report` row: `Report.orgId` is required with cascading-delete org
// ownership (RLS-scoped throughout ReportsService), but the NCNP Compiled
// Report is kingdom-wide/cross-org (see NcnpReportService, which uses
// runAsSupervisor, no org context at all). Forcing it into `Report` would
// mean inventing a fake owning org. Instead: global reference-style data,
// no org_id, no RLS — same pattern as Domain/MethodologyVersion/Role.
// Field names/meaning are copied from Report's own approval columns
// (generatedBy/At, reviewedBy/At, archivedAt-equivalent) so the service
// logic mirrors ReportsService.confirm/approve/reject/archive closely,
// just on this table and with a genuine 3-step split (System Admin
// generates -> System Reviewer approves/rejects with mandatory notes ->
// System Admin publishes) instead of Report's 2-step officer-confirm ->
// reviewer-approves-straight-to-released flow.
enum NcnpReportReviewStatus {
  draft // generated, awaiting System Reviewer decision
  approved // Reviewer approved, awaiting System Admin publish
  rejected // Reviewer rejected — terminal
  released // System Admin published — terminal, matches Report's "released" meaning
}

model NcnpReportReview {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  status        NcnpReportReviewStatus @default(draft)
  // Snapshot of NcnpReportService.getReport()'s return value at generation
  // time — frozen, never regenerated, same "content: Json" convention as
  // Report.content.
  content       Json
  // periodDays/dormantDays the snapshot was generated with, for display.
  filters       Json
  generatedBy   String                 @map("generated_by") @db.Uuid
  generatedAt   DateTime               @default(now()) @map("generated_at") @db.Timestamptz(6)
  reviewedBy    String?                @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  // Mandatory reviewer notes — required by the service on both approve and
  // reject (client requirement), same pattern as Survey.approverComments.
  // Nullable here only because the column must allow a not-yet-decided
  // (draft) row to have none yet.
  reviewerNotes String?                @map("reviewer_notes") @db.VarChar(2000)
  publishedBy   String?                @map("published_by") @db.Uuid
  publishedAt   DateTime?              @map("published_at") @db.Timestamptz(6)

  @@index([status])
  @@map("ncnp_report_reviews")
}

// ──────── Methodology Configuration ────────
// Global reference/master data (no orgId, no RLS — same pattern as
// Role/ConsentPolicy/Domain), single-row: the platform-wide methodology
// baseline (priority thresholds, confidence-flag rule, version label) that
// Priority Dashboard and Response Quality read at scoring/assessment time
// instead of hardcoding these numbers in the placeholder functions. Domains/
// Subdomains (see Domain/SubDomain models above) are the other half of this
// same "Methodology Configuration" screen.
enum MethodologyStatus {
  draft
  published
}

model MethodologyConfig {
  id                     String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Free-text version label the reviewer sets (e.g. "v1.0 - Approved
  // implementation baseline") — mirrors question-bank-v1.json's own
  // _meta.versionLabel convention, not a semver the app enforces.
  version                String            @db.VarChar(100)
  status                 MethodologyStatus @default(draft)
  publishedBy            String?           @map("published_by") @db.Uuid
  publishedAt            DateTime?         @map("published_at") @db.Timestamptz(6)
  // Priority Dashboard's placeholder scoring thresholds — see
  // priority.placeholder.ts. Shape: { criticalSeverity, highSeverity,
  // mediumSeverity, equityHighSeverity }.
  priorityThresholds     Json              @map("priority_thresholds")
  // The 9 configurable Priority Scoring factors from scope.md §8 — each
  // { key, label, weight }. `key`/`label` are the methodology's fixed
  // vocabulary (scorePriority keys off `key`); only `weight` is meant to be
  // edited from the Methodology Configuration screen.
  priorityFactorWeights  Json              @map("priority_factor_weights")
  // Response Quality's confidence-flag rule — see
  // response-quality.placeholder.ts. Shape: { dontKnowRatioThreshold,
  // minRespondentsForStandardConfidence }.
  confidenceFlagSettings Json              @map("confidence_flag_settings")
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?           @map("updated_by") @db.Uuid

  @@map("methodology_configs")
}

// UNUSED — superseded by sourcing the Survey Builder's "Methodology
// Version" dropdown directly from `MethodologyConfig`'s own version/status
// (see MethodologyConfigService.listVersionOptions): publishing a version in
// Settings never wrote to this table, so it could never actually reflect
// what was published. Left in place (additive-only migrations; not dropped)
// rather than deleted, since nothing depends on removing it —
// Survey.methodologyVersion stores the chosen label as a plain string
// snapshot, never a relation to this table, so nothing breaks by leaving it
// unread.
model MethodologyVersionOption {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version   String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  // Display order in the Researcher's selector — ascending.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("methodology_version_options")
}

// ──────── Question Bank / AI Survey Builder ────────

// Global reference/master data (no org_id, no RLS — same pattern as
// Domain/SubDomain) — imported from the approved methodology package via
// prisma/import-methodology.ts (RIO-AI-005), read-only to cnap_app at runtime.
//
// VERSION-SCOPED (see 20260812090000_methodology_version_scoped_questions): a
// question's identity is (methodologyVersionId, questionId), NOT questionId
// alone. `questionId` was globally unique and `methodologyVersionId` was never
// populated, so importing a second bank produced near-duplicate questions the
// Survey Builder picker could not tell apart — patched twice with prefix-regex
// UPDATEs before this. Every read that feeds the picker or AI suggestions MUST
// filter by methodology version; see QuestionsService.
model Question {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  questionId       String  @map("question_id") @db.VarChar(64)
  domain           String  @db.VarChar(120)
  subDomain        String  @map("sub_domain") @db.VarChar(120)
  indicator        String? @db.VarChar(200)
  kpi              String? @db.VarChar(200)
  questionText     String  @map("question_text")
  answerType       String  @map("answer_type") @db.VarChar(64)
  answerOptions    Json?   @map("answer_options")
  // "required" | "conditional" | "required_per_eligible_person" |
  // "not_fielded" | "on_hold" — read from the methodology's own
  // "Mandatory / Optional" column, never hardcoded.
  requiredOptional String  @map("required_optional") @db.VarChar(64)
  usedInMvp        Boolean @default(true) @map("used_in_mvp")
  reportMapping    String? @map("report_mapping")

  analyticalCategory   String?  @map("analytical_category") @db.VarChar(100)
  // The decomposed base type that drives scoring: SINGLE_SELECT | LIKERT_5 |
  // MULTI_SELECT | NUMERIC | CHECKLIST_MATRIX | TEMPLATE_PATTERN |
  // METADATA_MODULE | PERSON_ROSTER_MODULE. Roster-qualified and compound
  // answer types collapse onto their base here, per METH — Answer Type Defs
  // ("scored exactly as the base type" / "the base type drives the severity
  // score"); the modifiers live in the flags below.
  measurementMode      String   @default("SINGLE_SELECT") @map("measurement_mode") @db.VarChar(64)
  isScoreable          Boolean  @default(true) @map("is_scoreable")
  severityDirection    String?  @map("severity_direction") @db.VarChar(64)
  conditionalRule      Json?    @map("conditional_rule")
  methodologyVersionId String   @map("methodology_version_id") @db.Uuid
  scoringLookupKey     String?  @map("scoring_lookup_key") @db.VarChar(150)
  priorityWeight       Decimal? @map("priority_weight") @db.Decimal(5, 2)

  // ──────── v5.0 methodology attributes (RIO-AI-005) ────────
  // The workbook's verbatim Answer Type label, kept for traceability alongside
  // the decomposed `measurementMode` above.
  answerTypeRaw                String?  @map("answer_type_raw") @db.VarChar(120)
  // "person" | "child" | "woman" | "youth" when administered once per eligible
  // individual; null otherwise.
  rosterScope                  String?  @map("roster_scope") @db.VarChar(20)
  isCompound                   Boolean  @default(false) @map("is_compound")
  isAdminRecord                Boolean  @default(false) @map("is_admin_record")
  // False for the 7 questionnaire-structure/roster/template modules
  // (XDM-01..07) — instrument scaffolding, not fielded questions. 193 - 7 = 186.
  isFielded                    Boolean  @default(true) @map("is_fielded")
  // 186 - WSH-15 (administrative record) - SOC-08 (on hold under the
  // sensitivity protocol) = the 184 actually asked of a household.
  isHouseholdFielded           Boolean  @default(true) @map("is_household_fielded")
  // XDM-08 is scored but excluded by design from the nine-domain Village
  // Development Needs Index; it feeds the vulnerability classification.
  excludedFromNineDomainIndex  Boolean  @default(false) @map("excluded_from_nine_domain_index")
  // The anchor KPI's question code this feeder item enriches (20 items).
  feedsKpiAnchor               String?  @map("feeds_kpi_anchor") @db.VarChar(64)
  // The v1.0 -> v5.0 code map ("Former code: H01"). All 193 v5.0 items carry one.
  formerCode                   String?  @map("former_code") @db.VarChar(64)
  targetRespondent             String?  @map("target_respondent")
  // The roster iteration scope verbatim, e.g. "each child aged 0-59 months".
  rosterLoop                   String?  @map("roster_loop")

  surveyQuestions    SurveyQuestion[]
  // RESTRICT, not SetNull: a version any question still belongs to must not be
  // deletable — retire it (status = 'RETIRED') instead.
  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Restrict)

  @@unique([methodologyVersionId, questionId])
  @@index([domain, subDomain])
  @@index([methodologyVersionId])
  @@map("questions")
}

// One row per AI Classification run against a Study's problem statement —
// same "suggestion, kept forever even after a human overrides it" shape as
// the older AiDecision model, but scoped to this feature's own
// domain/sub-domain/question-suggestion shape rather than AiDecision's.
model AiSuggestion {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  needId               String   @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId              String   @map("study_id") @db.Uuid
  type                 String   @db.VarChar(64)
  inputHash            String?  @map("input_hash") @db.VarChar(64)
  suggestedDomain      String?  @map("suggested_domain") @db.VarChar(120)
  suggestedSubDomain   String?  @map("suggested_sub_domain") @db.VarChar(120)
  suggestedQuestionIds Json?    @map("suggested_question_ids")
  confidence           Decimal  @db.Decimal(5, 2)
  reason               String
  modelName            String   @map("model_name") @db.VarChar(150)
  promptVersion        String   @map("prompt_version") @db.VarChar(64)
  rawResponse          Json?    @map("raw_response")
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org           Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need          Need            @relation(fields: [needId], references: [id], onDelete: Cascade)
  study         Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)
  humanDecisions HumanDecision[]

  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@map("ai_suggestions")
}

// A human reviewer's decision on an AiSuggestion — approve as-is or
// override with a final domain/sub-domain/question set. aiSuggestionId is
// nullable/SetNull so removing a suggestion (shouldn't normally happen)
// can't take the decision record down with it.
model HumanDecision {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  studyId          String   @map("study_id") @db.Uuid
  aiSuggestionId   String?  @map("ai_suggestion_id") @db.Uuid
  decision         String   @db.VarChar(64)
  finalDomain      String?  @map("final_domain") @db.VarChar(120)
  finalSubDomain   String?  @map("final_sub_domain") @db.VarChar(120)
  finalQuestionIds Json?    @map("final_question_ids")
  reason           String?
  decidedBy        String   @map("decided_by") @db.Uuid
  decidedAt        DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  org          Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  study        Study         @relation(fields: [studyId], references: [id], onDelete: Cascade)
  aiSuggestion AiSuggestion? @relation(fields: [aiSuggestionId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([studyId])
  @@map("human_decisions")
}

// Structured reason code for rejecting a submitted Survey — see
// Survey.rejectionReasonCode. Survey.approverComments (reviewer notes) is
// mandatory for every code now, not just REJ_99 — see
// SurveysService.rejectSurvey for the enforcement.
enum RejectionReasonCode {
  REJ_01 @map("REJ-01") // Incomplete survey design
  REJ_02 @map("REJ-02") // Methodology non-compliance
  REJ_03 @map("REJ-03") // Duplicate of an existing survey
  REJ_04 @map("REJ-04") // Incorrect need or study linkage
  REJ_05 @map("REJ-05") // Out-of-scope geography or target population
  REJ_06 @map("REJ-06") // Data quality concerns
  REJ_07 @map("REJ-07") // Missing required attachments or approvals
  REJ_99 @map("REJ-99") // Other
}

// The Survey Builder's own per-Study survey — a curated ordered subset of
// Questions, distinct from the Publish Survey/Citizen flow's PublicSurveyLink
// (that flow is the placeholder fixed-question-set QR flow; this is the
// eventual real per-Study question set once a human finalizes it).
model Survey {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  needId    String   @map("need_id") @db.Uuid
  // Denormalized from Need.studyId — see Evidence.studyId's comment.
  studyId   String   @map("study_id") @db.Uuid
  title     String   @db.VarChar(300)
  status    String   @db.VarChar(64)
  // Snapshot of MethodologyConfig.version at the moment this Survey was
  // (most recently) published — never a live reference, so a later
  // Methodology/Question Bank change can't silently change what an
  // already-published Survey claims it was built against. Set on every
  // PUBLISHED transition (see SurveysService.saveDraft); null for a Survey
  // that has never been published, or one published before this column
  // existed.
  methodologyVersion String? @map("methodology_version") @db.VarChar(100)
  // RIO-FR-011 (client-confirmed): once PUBLISHED with responses collected,
  // a survey is never edited in place — SurveysService.createNewVersion
  // creates a new DRAFT row instead, incrementing `version` and pointing
  // `previousVersionId` at this one. This (the old) row, and every response
  // already attached to it (SurveyResponse.surveyId), never changes —
  // "existing responses stay attached to the version they were collected
  // under" is true by construction, not by any special-case logic.
  // `@unique` on previousVersionId: a given version can be superseded by at
  // most one newer version, never branched.
  version            Int     @default(1)
  previousVersionId  String? @unique @map("previous_version_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ──────── Sample Description ────────
  // A Survey Design step, completed by the Researcher before Submit for
  // Approval (see SurveysService.submitForApproval's gate — mandatory
  // together, same "all or nothing" gate as methodologyVersion above), and
  // shown to the Approver during review for context on who's being
  // surveyed and how. All four nullable because a DRAFT survey created
  // before this step is filled (or before this feature existed) has none
  // yet.
  targetGroup         String? @map("target_group") @db.VarChar(500)
  expectedSampleSize  Int?    @map("expected_sample_size")
  selectionApproach   String? @map("selection_approach") @db.VarChar(1000)
  geographicCoverage  String? @map("geographic_coverage") @db.VarChar(500)

  // ──────── Survey Approval workflow ────────
  // status also takes SUBMITTED and REJECTED now, alongside the existing
  // DRAFT/PUBLISHED — see SurveysService for the state machine. The
  // Researcher (surveyBuilder/write) owns DRAFT<->SUBMITTED; only the
  // Approver (surveyBuilder/approve) can move SUBMITTED->PUBLISHED or
  // SUBMITTED->REJECTED. No relation to User here — same "plain UUID,
  // resolved by app code" convention as `createdBy` above, not a Prisma
  // relation.
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  // The Approver's reviewer notes for the most recent decision — mandatory
  // on both Approve & Publish and Reject (client requirement: reviewer
  // notes must be captured before publishing). Shown prominently to the
  // Researcher when they reopen a REJECTED survey; also set on PUBLISHED
  // surveys now. Cleared on the next Submit for Approval (a Reject ->
  // resubmit round), so it never lingers as stale feedback once a new round
  // of review has started — never cleared once PUBLISHED, since that's a
  // terminal state with no resubmit path. The audit log keeps the full
  // history regardless; this column is only "the current outstanding note."
  // Nullable only because surveys approved/rejected before this requirement
  // existed have no value.
  approverComments String?   @map("approver_comments")
  // Structured reason for the most recent rejection, alongside the free-text
  // approverComments above — mandatory whenever a survey is rejected (see
  // SurveysService.rejectSurvey), required so "Rejected Surveys — Reason
  // Breakdown" on the NCNP Consolidated Report can group on a real code
  // instead of an illustrative placeholder split. Cleared on the next Submit
  // for Approval, same lifecycle as approverComments. Nullable here only
  // because surveys rejected before this field existed have no value.
  rejectionReasonCode RejectionReasonCode? @map("rejection_reason_code")
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy       String?   @map("approved_by") @db.Uuid
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy       String?   @map("rejected_by") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy      String?   @map("published_by") @db.Uuid

  org             Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  need            Need                   @relation(fields: [needId], references: [id], onDelete: Cascade)
  study           Study                  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  // RIO-FR-011 self-relation: previousVersion is null for the first-ever
  // version of a Need's survey. onDelete: SetNull (not Cascade) — deleting a
  // newer draft version must never cascade into deleting the published
  // version it was drafted from.
  previousVersion Survey?                @relation("SurveyVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     Survey?                @relation("SurveyVersionChain")
  surveyQuestions            SurveyQuestion[]
  builderResponses           SurveyBuilderResponse[]
  responseAnswers            ResponseAnswer[]
  responseSeverityScores     ResponseSeverityScore[]
  scoreRollups               ScoreRollup[]
  villagePriorityAssessments VillagePriorityAssessment[]
  aiPrioritySummaries        AiPrioritySummary[]
  // Survey-scoped reports (RPT01 / RPT15) — see Report.surveyId.
  reports                    Report[]
  // Abandonment tracking — the sessions opened against this survey version.
  sessions                   SurveySession[]

  @@index([orgId])
  @@index([needId])
  @@index([studyId])
  @@map("surveys")
}

// Two kinds of rows, discriminated by whether `questionId` is set:
//   - Question Bank question: questionId set, customText/customAnswerType
//     null. Text/type/options/indicator/KPI/domain all come from the
//     Question row — never editable here, only order/isRequired are.
//   - Additional (open-ended) question: questionId null, customText set.
//     A Research Officer's study-specific question, never written into the
//     `questions` (Question Bank) table — it belongs only to this Survey.
//     No KPI/indicator/report-mapping/domain — those are Question Bank
//     concepts this kind of question deliberately has none of.
// Both kinds share one `order` sequence so the two Survey Builder UI
// sections (AI Recommended, Additional) still save as a single ordered list.
model SurveyQuestion {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  surveyId         String  @map("survey_id") @db.Uuid
  questionId       String? @map("question_id") @db.Uuid
  customText       String? @map("custom_text")
  customAnswerType String? @map("custom_answer_type") @db.VarChar(64)
  // Options list for an additional question of type multiple_choice/
  // checkbox — null for every other additional-question type, and always
  // null for Question Bank questions (those use `questions.answer_options`).
  customOptions    Json?   @map("custom_options")
  // Domain/Sub-domain/KPI for an additional (custom) question — a Question
  // Bank question already carries this via its linked Question row
  // (question.domain/subDomain/kpi), so these three are always null there;
  // only meaningful when customText is set. Nullable and optional at the
  // DB level even for custom rows: required-for-new-questions is an
  // application-layer rule (Survey Builder's dialog + updateQuestions), not
  // a DB constraint, so a custom question created before this field existed
  // keeps working unmodified — see this model's migration comment.
  domain           String? @db.VarChar(120)
  subDomain        String? @map("sub_domain") @db.VarChar(120)
  kpi              String? @db.VarChar(200)
  order            Int
  isRequired       Boolean @default(true) @map("is_required")

  survey   Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([questionId])
  @@map("survey_questions")
}

// NOTE: this is deliberately NOT named/mapped "survey_responses" — that
// table name is already taken by the Publish Survey/Citizen flow's
// SurveyResponse model (org/study/survey-link/contact-scoped, backs the
// live citizen OTP submission flow, Response Quality, Priority, Reports).
// The original migration for this feature also called its table
// "survey_responses", which would collide outright (CREATE TABLE would
// fail) since that table already exists. Renamed here — and in this
// feature's own migration.sql — to survey_builder_responses instead, since
// this is Survey Builder's own response shape (survey_id + answers only,
// no org/contact scoping), a genuinely different concept from the citizen
// flow's SurveyResponse.
model SurveyBuilderResponse {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  surveyId    String   @map("survey_id") @db.Uuid
  answers     Json
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("survey_builder_responses")
}

model MethodologyVersion {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String   @db.VarChar(200)
  version     String   @unique @db.VarChar(100)
  status      String   @default("DRAFT") @db.VarChar(64) // DRAFT | PUBLISHED | RETIRED
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  approvedBy  String?  @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scoringLookups             ScoringLookup[]
  questions                  Question[]
  surveySeverityScores       ResponseSeverityScore[]
  scoreRollups               ScoreRollup[]
  domainPriorityConfigs      DomainPriorityConfig[]
  villagePriorityAssessments VillagePriorityAssessment[]
  studies                    Study[]

  @@map("methodology_versions")
}

model ScoringLookup {
  id                   String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  methodologyVersionId String             @map("methodology_version_id") @db.Uuid
  questionId           String             @map("question_id") @db.VarChar(64)
  lookupType           String             @map("lookup_type") @db.VarChar(64) // OPTION | LIKERT | NUMERIC | MULTI_SELECT
  optionId             String?            @map("option_id") @db.VarChar(100)
  optionOrder          Int?               @map("option_order")
  severityScore        Decimal?           @map("severity_score") @db.Decimal(5, 2)
  numericFloor         Decimal?           @map("numeric_floor") @db.Decimal(10, 2)
  numericCeiling       Decimal?           @map("numeric_ceiling") @db.Decimal(10, 2)
  severityDirection    String?            @map("severity_direction") @db.VarChar(64)
  isExcluded           Boolean            @default(false) @map("is_excluded")
  exclusionReason      String?            @map("exclusion_reason") @db.VarChar(64)
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  methodologyVersion   MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  responseSeverityScores ResponseSeverityScore[]

  @@index([methodologyVersionId])
  @@index([questionId])
  @@map("scoring_lookups")
}

model ResponseAnswer {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  surveyResponseId   String   @map("survey_response_id") @db.Uuid
  surveyId           String   @map("survey_id") @db.Uuid
  studyId            String   @map("study_id") @db.Uuid
  villageId          String?  @map("village_id") @db.VarChar(150)
  respondentId       String?  @map("respondent_id") @db.VarChar(255)
  questionId         String   @map("question_id") @db.VarChar(64)
  answerOptionId     String?  @map("answer_option_id") @db.VarChar(100)
  answerNumericValue Decimal? @map("answer_numeric_value") @db.Decimal(15, 4)
  answerText         String?  @map("answer_text")
  answerOptionIds    Json?    @map("answer_option_ids") // For multi-select answers
  isApplicable       Boolean  @default(true) @map("is_applicable")
  submittedAt        DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org            Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  surveyResponse SurveyResponse  @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  survey         Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  study          Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)
  severityScores ResponseSeverityScore[]

  @@index([orgId])
  @@index([surveyResponseId])
  @@index([surveyId])
  @@index([studyId])
  @@map("response_answers")
}

model ResponseSeverityScore {
  id                   String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  responseAnswerId     String             @map("response_answer_id") @db.Uuid
  surveyResponseId     String             @map("survey_response_id") @db.Uuid
  surveyId             String             @map("survey_id") @db.Uuid
  studyId              String             @map("study_id") @db.Uuid
  villageId            String?            @map("village_id") @db.VarChar(150)
  questionId           String             @map("question_id") @db.VarChar(64)
  methodologyVersionId String             @map("methodology_version_id") @db.Uuid
  scoringLookupId      String?            @map("scoring_lookup_id") @db.Uuid
  rawAnswerSnapshot    Json               @map("raw_answer_snapshot")
  severityScore        Decimal?           @map("severity_score") @db.Decimal(5, 2)
  scoreStatus          String             @map("score_status") @db.VarChar(64) // SCORED | EXCLUDED | NOT_APPLICABLE | NOT_SCOREABLE | ERROR
  exclusionReason      String?            @map("exclusion_reason") @db.VarChar(64)
  calculatedAt         DateTime           @default(now()) @map("calculated_at") @db.Timestamptz(6)
  calculationVersion   String             @map("calculation_version") @db.VarChar(64)

  org                Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  responseAnswer     ResponseAnswer     @relation(fields: [responseAnswerId], references: [id], onDelete: Cascade)
  surveyResponse     SurveyResponse     @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  survey             Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  study              Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)
  scoringLookup      ScoringLookup?     @relation(fields: [scoringLookupId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([responseAnswerId])
  @@index([surveyResponseId])
  @@index([surveyId])
  @@index([studyId])
  @@map("response_severity_scores")
}

model ScoreRollup {
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                 String             @map("org_id") @db.Uuid
  studyId               String             @map("study_id") @db.Uuid
  surveyId              String             @map("survey_id") @db.Uuid
  villageId             String?            @map("village_id") @db.VarChar(150)
  methodologyVersionId  String             @map("methodology_version_id") @db.Uuid
  rollupLevel           String             @map("rollup_level") @db.VarChar(64) // QUESTION | KPI | INDICATOR | SUB_DOMAIN | DOMAIN | OVERALL
  entityId              String             @map("entity_id") @db.VarChar(150) // questionId, kpiId, etc.
  entityNameSnapshot    String             @map("entity_name_snapshot") @db.VarChar(300)
  severityScore         Decimal?           @map("severity_score") @db.Decimal(5, 2)
  validResponseCount    Int                @map("valid_response_count")
  excludedResponseCount Int                @map("excluded_response_count")
  dontKnowCount         Int                @map("dont_know_count")
  dontKnowRate          Decimal            @map("dont_know_rate") @db.Decimal(5, 4)
  notApplicableCount    Int                @map("not_applicable_count")
  confidenceLevel       String             @map("confidence_level") @db.VarChar(64) // LOW | STANDARD
  calculatedAt          DateTime           @default(now()) @map("calculated_at") @db.Timestamptz(6)
  calculationVersion    String             @map("calculation_version") @db.VarChar(64)

  org                Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  study              Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  survey             Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([studyId, surveyId, villageId, methodologyVersionId, rollupLevel, entityId])
  @@index([orgId])
  @@map("score_rollups")
}

// ──────── Priority Scoring v2 — Domain-weighted Performance ────────
//
// DomainPriorityConfig: developer-seeded configuration imported via
// prisma/import-domain-priority-config.ts. No orgId / RLS — global
// reference-data (same pattern as Domain/SubDomain/Question).
// Weights must sum to 1.00 and all be > 0; enforced by import script.
// A version is immutable once any Survey references it as PUBLISHED.
model DomainPriorityConfig {
  id                           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  methodologyVersionId         String   @map("methodology_version_id") @db.Uuid
  // Normalized upper-snake key, e.g. "HEALTH", "WATER_SANITATION".
  domainKey                    String   @map("domain_key") @db.VarChar(100)
  domainNameSnapshot           String   @map("domain_name_snapshot") @db.VarChar(200)
  // 0–1 share of the total priority score; five decimal places.
  weight                       Decimal  @db.Decimal(6, 5)
  isCriticalDomain             Boolean  @default(false) @map("is_critical_domain")
  // Critical domain performance strictly below this → HIGH override.
  criticalPerformanceThreshold Int      @default(30) @map("critical_performance_threshold")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  methodologyVersion   MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([methodologyVersionId, domainKey])
  @@index([methodologyVersionId])
  @@map("domain_priority_configs")
}

// VillagePriorityAssessment: upserted each time recalculate() runs.
// One row per (study × survey × village × methodology version).
// villageId = '' means consolidated (all villages).
model VillagePriorityAssessment {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  studyId              String   @map("study_id") @db.Uuid
  surveyId             String   @map("survey_id") @db.Uuid
  villageId            String   @map("village_id") @db.VarChar(150)
  methodologyVersionId String   @map("methodology_version_id") @db.Uuid
  // Weighted sum of DomainPerformanceScores (0–100). Low = high priority.
  priorityScore        Decimal  @map("priority_score") @db.Decimal(8, 4)
  // HIGH | MEDIUM | LOW
  priorityStatus       String   @map("priority_status") @db.VarChar(20)
  overrideApplied      Boolean  @default(false) @map("override_applied")
  overrideReason       String?  @map("override_reason") @db.VarChar(500)
  // Per-domain snapshot JSON array. Each element:
  // { domainKey, domainNameSnapshot, domainSeverityScore,
  //   domainPerformanceScore, domainWeight, weightedContribution,
  //   isCriticalDomain, criticalThreshold, triggeredOverride }
  domainComponents     Json     @map("domain_components")
  calculatedAt         DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)
  calculationVersion   String   @map("calculation_version") @db.VarChar(64)

  org                Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  study              Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  survey             Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  methodologyVersion MethodologyVersion @relation(fields: [methodologyVersionId], references: [id], onDelete: Cascade)

  @@unique([studyId, surveyId, villageId, methodologyVersionId])
  @@index([orgId])
  @@index([studyId])
  @@index([surveyId])
  @@map("village_priority_assessments")
}

